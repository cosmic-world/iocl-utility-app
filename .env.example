# Local development can leave this empty; package.json proxies /api to port 5000.
# In AWS Amplify, set this to the public HTTPS URL of the deployed Express API.
REACT_APP_API_URL=https://your-api-domain.example.com

# Gmail SMTP credentials for OTP emails (server-side, required)
MAIL_USER=your-gmail-address@gmail.com
MAIL_APP_PASSWORD=your-16-char-gmail-app-password
